node_modules/
dist/
# shared/dist/ is intentionally committed (consumed by Node for Max via the
# JSON Schema artifact + by the MCP server at runtime via pnpm workspace link).
!shared/dist/
!shared/dist/**
build/
*.log
.DS_Store
.env
.env.local
*.tsbuildinfo

# Max for Live build artifacts
*.maxsnap
Max.log

# M4L device binary: user-owned during Max patch iteration.
# We commit only the .maxpat JSON exports under device/patchers/ for diff-ability.
# The .amxd will be added to the repo once the M4L side stabilizes (post-Plan 1).
device/Soniq.Bridge.amxd
device/*.amxd

# Max Project file (auto-generated, user-specific paths inside)
device/*.amxproj
device/.amxd.tmp
device/.maxpat.tmp
